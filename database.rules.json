{
  "rules": {
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "root.child('admins').child(auth.uid).val() === true || (auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'password' && !data.parent().exists())",
        ".validate": "newData.val() === true || (data.exists() && root.child('admins').child(auth.uid).val() === true && auth.uid != $uid)"
      }
    },
    "noticias": {
      ".read": true,
      ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && root.child('admins').child(auth.uid).val() === true"
    },
    "videos": {
      ".read": true,
      ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && root.child('admins').child(auth.uid).val() === true"
    },
    "content-links": {
      ".read": true,
      ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && root.child('admins').child(auth.uid).val() === true",
      "main": {
        "$section": {
          "$field": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 1000)"
          }
        }
      }
    },
    "site_stats": {
      ".read": true,
      ".write": "auth != null",
      ".validate": "root.child('admins').child(auth.uid).val() === true || newData.hasChildren(['total_visits', 'daily', 'monthly', 'last_updated'])",
      "total_visits": {
        ".validate": "root.child('admins').child(auth.uid).val() === true || (newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() <= data.val() + 1))"
      },
      "unique_total": {
        ".validate": "root.child('admins').child(auth.uid).val() === true || (newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() <= data.val() + 1))"
      },
      "daily": {
        "$dateKey": {
          ".validate": "root.child('admins').child(auth.uid).val() === true || (newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() <= data.val() + 1))"
        }
      },
      "monthly": {
        "$monthKey": {
          ".validate": "root.child('admins').child(auth.uid).val() === true || (newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() <= data.val() + 1))"
        }
      },
      "hourly": {
        "$dateKey": {
          "$hourKey": {
            ".validate": "root.child('admins').child(auth.uid).val() === true || (newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() <= data.val() + 1))"
          }
        }
      },
      "unique_daily": {
        "$dateKey": {
          ".validate": "root.child('admins').child(auth.uid).val() === true || (newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() <= data.val() + 1))"
        }
      },
      "unique_monthly": {
        "$monthKey": {
          ".validate": "root.child('admins').child(auth.uid).val() === true || (newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() <= data.val() + 1))"
        }
      },
      "unique_hourly": {
        "$dateKey": {
          "$hourKey": {
            ".validate": "root.child('admins').child(auth.uid).val() === true || (newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() <= data.val() + 1))"
          }
        }
      },
      "pages": {
        "$pageKey": {
          ".validate": "root.child('admins').child(auth.uid).val() === true || (newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() <= data.val() + 1))"
        }
      },
      "referrers": {
        "$referrerKey": {
          ".validate": "root.child('admins').child(auth.uid).val() === true || (newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() <= data.val() + 1))"
        }
      },
      "click_targets": {
        "$targetKey": {
          ".validate": "root.child('admins').child(auth.uid).val() === true || !newData.exists() || newData.hasChildren(['count'])",
          "count": {
            ".validate": "root.child('admins').child(auth.uid).val() === true || (newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() <= data.val() + 1))"
          },
          "label": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 200)"
          },
          "href": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 1000)"
          },
          "page": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 200)"
          },
          "last_clicked": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 40)"
          }
        }
      },
      "last_updated": {
        ".validate": "newData.isString()"
      }
    },
    "site_unique_views": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null",
      "daily": {
        "$dateKey": {
          "$visitorHash": {
            ".validate": "!newData.exists() || (newData.hasChildren(['timestamp', 'page']) && newData.child('timestamp').isNumber() && newData.child('page').isString() && newData.child('page').val().length <= 200)"
          }
        }
      },
      "all": {
        "$visitorHash": {
          ".validate": "!newData.exists() || (newData.hasChildren(['first_seen', 'last_page']) && newData.child('first_seen').isNumber() && newData.child('last_page').isString() && newData.child('last_page').val().length <= 200)"
        }
      }
    },
    "active_users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null",
      "$userId": {
        ".validate": "!newData.exists() || (newData.hasChildren(['sessionId', 'timestamp', 'page']) && newData.child('sessionId').isString() && newData.child('sessionId').val().length <= 128 && newData.child('timestamp').isNumber() && newData.child('page').isString() && newData.child('page').val().length <= 200)"
      }
    },
    "active_users_history": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null",
      "$entryId": {
        ".validate": "!newData.exists() || (newData.hasChildren(['sessionId', 'page', 'timestamp']) && newData.child('sessionId').isString() && newData.child('sessionId').val().length <= 128 && newData.child('page').isString() && newData.child('page').val().length <= 200 && newData.child('timestamp').isNumber())"
      }
    },
    "click_stats": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null",
      "visitors": {
        "$dateKey": {
          "$visitorHash": {
            ".validate": "root.child('admins').child(auth.uid).val() === true || !newData.exists() || (newData.hasChildren(['total_clicks']) && newData.child('total_clicks').isNumber() && newData.child('total_clicks').val() >= 0 && (!data.exists() || !data.hasChild('total_clicks') || newData.child('total_clicks').val() <= data.child('total_clicks').val() + 1))",
            "total_clicks": {
              ".validate": "root.child('admins').child(auth.uid).val() === true || (newData.isNumber() && newData.val() >= 0)"
            }
          }
        }
      },
      "targets": {
        "$targetKey": {
          ".validate": "root.child('admins').child(auth.uid).val() === true || !newData.exists() || newData.hasChildren(['count'])",
          "count": {
            ".validate": "root.child('admins').child(auth.uid).val() === true || (newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() <= data.val() + 1))"
          },
          "label": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 200)"
          },
          "href": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 1000)"
          },
          "page": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 200)"
          },
          "last_clicked": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 40)"
          }
        }
      },
      "pages": {
        "$pageKey": {
          ".validate": "root.child('admins').child(auth.uid).val() === true || !newData.exists() || (newData.hasChildren(['count']) && newData.child('count').isNumber() && newData.child('count').val() >= 0 && (!data.exists() || !data.hasChild('count') || newData.child('count').val() <= data.child('count').val() + 1))"
        }
      },
      "daily": {
        "$dateKey": {
          "targets": {
            "$targetKey": {
              ".validate": "root.child('admins').child(auth.uid).val() === true || !newData.exists() || (newData.hasChildren(['count']) && newData.child('count').isNumber() && newData.child('count').val() >= 0 && (!data.exists() || !data.hasChild('count') || newData.child('count').val() <= data.child('count').val() + 1))"
            }
          }
        }
      }
    },
    "article_reads": {
      ".read": true,
      "$noticiaId": {
        ".write": "auth != null",
        ".validate": "root.child('admins').child(auth.uid).val() === true || (newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() <= data.val() + 1))"
      }
    },
    "likes": {
      ".read": true,
      "$noticiaId": {
        "$userId": {
          ".write": "root.child('admins').child(auth.uid).val() === true || (auth != null && auth.uid === $userId)",
          ".validate": "(newData.hasChildren(['timestamp']) && newData.child('timestamp').isNumber()) || !newData.exists()",
          "timestamp": {
            ".validate": "newData.isNumber() && newData.val() > 0"
          }
        }
      }
    },
    "push_subscriptions": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$subscriptionId": {
        ".write": "auth != null",
        ".validate": "root.child('admins').child(auth.uid).val() === true || !newData.exists() || ($subscriptionId.matches(/^[a-f0-9]{64}$/) && newData.hasChildren(['subscription', 'topic', 'status', 'createdAt', 'updatedAt', 'lastSeenAt', 'userAgent', 'language', 'origin']) && newData.child('subscription').hasChildren(['endpoint', 'keys']) && newData.child('subscription/endpoint').isString() && newData.child('subscription/endpoint').val().matches(/^https:\\/\\/.+/) && newData.child('subscription/endpoint').val().length <= 1000 && (!newData.child('subscription/expirationTime').exists() || newData.child('subscription/expirationTime').isNumber() || newData.child('subscription/expirationTime').val() == null) && newData.child('subscription/keys').hasChildren(['p256dh', 'auth']) && newData.child('subscription/keys/p256dh').isString() && newData.child('subscription/keys/p256dh').val().length >= 16 && newData.child('subscription/keys/p256dh').val().length <= 512 && newData.child('subscription/keys/auth').isString() && newData.child('subscription/keys/auth').val().length >= 8 && newData.child('subscription/keys/auth').val().length <= 256 && newData.child('topic').isString() && newData.child('topic').val() == 'all' && newData.child('status').isString() && (newData.child('status').val() == 'active' || newData.child('status').val() == 'error' || newData.child('status').val() == 'invalid') && newData.child('createdAt').isNumber() && newData.child('createdAt').val() > 0 && newData.child('updatedAt').isNumber() && newData.child('updatedAt').val() > 0 && newData.child('lastSeenAt').isNumber() && newData.child('lastSeenAt').val() > 0 && newData.child('userAgent').isString() && newData.child('userAgent').val().length <= 300 && newData.child('language').isString() && newData.child('language').val().length <= 32 && newData.child('origin').isString() && newData.child('origin').val().matches(/^https:\\/\\/.+/) && newData.child('origin').val().length <= 120)"
      }
    },
    "push_meta": {
      ".read": false,
      ".write": false
    },
    "comentarios": {
      ".read": true,
      "$noticiaId": {
        "$comentarioId": {
          ".write": "root.child('admins').child(auth.uid).val() === true || (auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid)))",
          ".validate": "!newData.exists() || newData.hasChildren(['nome', 'texto', 'uid', 'timestamp'])",
          "nome": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length > 0 && newData.val().length <= 100)"
          },
          "texto": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length > 0 && newData.val().length <= 5000)"
          },
          "data": {
            ".validate": "!newData.exists() || newData.isString()"
          },
          "uid": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val() === auth.uid && newData.val().length <= 128)"
          },
          "timestamp": {
            ".validate": "!newData.exists() || (newData.isNumber() && newData.val() > 0 && newData.val() <= now + 300000)"
          },
          "respostas": {
            ".read": true,
            "$respostaId": {
              ".write": "root.child('admins').child(auth.uid).val() === true || (auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid)))",
              ".validate": "!newData.exists() || newData.hasChildren(['nome', 'texto', 'uid', 'timestamp'])",
              "nome": {
                ".validate": "!newData.exists() || (newData.isString() && newData.val().length > 0 && newData.val().length <= 100)"
              },
              "texto": {
                ".validate": "!newData.exists() || (newData.isString() && newData.val().length > 0 && newData.val().length <= 5000)"
              },
              "data": {
                ".validate": "!newData.exists() || newData.isString()"
              },
              "uid": {
                ".validate": "!newData.exists() || (newData.isString() && newData.val() === auth.uid && newData.val().length <= 128)"
              },
              "timestamp": {
                ".validate": "!newData.exists() || (newData.isNumber() && newData.val() > 0 && newData.val() <= now + 300000)"
              },
              "respostas": {
                ".read": true,
                "$respostaAninhadaId": {
                  ".write": "root.child('admins').child(auth.uid).val() === true || (auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid)))",
                  ".validate": "!newData.exists() || (newData.hasChildren(['nome', 'texto', 'uid', 'timestamp']) && newData.child('nome').isString() && newData.child('nome').val().length > 0 && newData.child('nome').val().length <= 100 && newData.child('texto').isString() && newData.child('texto').val().length > 0 && newData.child('texto').val().length <= 5000 && newData.child('uid').isString() && newData.child('uid').val() === auth.uid && newData.child('uid').val().length <= 128 && newData.child('timestamp').isNumber() && newData.child('timestamp').val() > 0 && newData.child('timestamp').val() <= now + 300000)"
                }
              }
            }
          }
        }
      }
    }
  }
}
